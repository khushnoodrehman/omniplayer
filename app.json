{
  "expo": {
    "name": "Omniplayer",
    "slug": "omniplayer",
    "version": "1.0.0",
    "newArchEnabled": false,
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "omniplayer",
    "userInterfaceStyle": "automatic",
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#1a1528"
    },
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1528",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.se7en11.omniplayer",
      "ndk": {
        "abiFilters": [
          "arm64-v8a"
        ]
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1528",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 180
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow OmniPlayer to access your photos.",
          "savePhotosPermission": "Allow OmniPlayer to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-audio",
      "expo-sqlite",
      "expo-sharing",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "buildArchs": [
              "arm64-v8a"
            ],
            "extraMavenRepos": [
              "../../node_modules/@notifee/react-native/android/libs"
            ],
            "extraProjectProps": {
              "ffmpegKitPackage": "audio"
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "72353047-7407-4e90-bb8a-0c2e7f3655f3"
      }
    }
  }
}